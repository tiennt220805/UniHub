# The versions and the size of the local cluster, in one place (Phase 7 checklist D81, D82). Read by
# k8s/scripts/cluster-up.sh. Changing a version is a decision of the owner (D81: stop and report, never switch
# the Kubernetes version silently to make something install).
#
# Kubernetes: the Minikube 1.38 default. Istio 1.31 supports Kubernetes 1.32-1.37 (istio.io/latest/about/
# supported-releases, read 2026-11-05). 1.31.3 is the newest 1.31 patch that was at least two weeks old on
# 2026-11-06 (published 2026-10-22).
KUBERNETES_VERSION=v1.35.1
ISTIO_VERSION=1.31.3
# D82: Docker Desktop at about 12 GB, Minikube at 10 GB and 6 CPUs.
MINIKUBE_PROFILE=unihub
MINIKUBE_MEMORY=10g
MINIKUBE_CPUS=6
