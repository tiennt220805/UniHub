    {
      "id": 10,
      "type": "timeseries",
      "title": "Notifications",
      "description": "Alert: warning when the oldest pending notification is over 5 minutes old.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (channel, result) (rate(unihub_notification_delivery_total[5m]))",
          "legendFormat": "{{channel}} {{result}}",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "unihub_notification_pending_oldest_age_seconds",
          "legendFormat": "oldest pending (s)",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
