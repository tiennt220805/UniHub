# ==========================================
# Root .gitignore — monorepo-wide, tool-agnostic only.
# Build-tool-specific rules (Gradle/Java) live in each app, e.g. apps/backend/.gitignore.
# ==========================================

# ------------------------------------------
# Operating System & System Junk (macOS / Windows)
# ------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------
# Shared IDE / Editor (workspace-level)
# ------------------------------------------
.idea/
.vscode/

# ------------------------------------------
# Environment & Secrets (never commit)
# ------------------------------------------
.env
.env.local
*.pem
*.key
*.p12

# Security scan reports (CI artifacts only, never committed — test-strategy.md §6)
dc-report/
dc-data/

# ------------------------------------------
# Local Kubernetes (Phase 7): the local CA and its private keys, made by k8s/scripts/make-local-ca.sh
# ------------------------------------------
k8s/.local-ca/
