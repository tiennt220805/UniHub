# Local dev docker-compose.yml config — shape-only template, never real credentials
# (mirrors k8s/base/secret.example.yaml's pattern: docs/technical-design/platform/deployment-and-cicd.md §2).
# Copy to .env (already .gitignore'd) and fill in your own local-only values. .env is never committed.

POSTGRES_USER=unihub
POSTGRES_PASSWORD=<set a local-only password>
POSTGRES_DB=unihub
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBITMQ_USER=unihub
RABBITMQ_PASSWORD=<set a local-only password>
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
