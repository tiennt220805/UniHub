# DEV ONLY — not a deployment deliverable (K8s/Minikube per docs/requirement.md is the real target).
# Local dev docker-compose.yml config — shape-only template, never real credentials
# (mirrors k8s/base/secret.example.yaml's pattern: docs/technical-design/platform/deployment-and-cicd.md §2).
#
# docker-compose.yml already has dev-only defaults for every one of these — you do NOT need this file to
# run `docker compose up -d`. Copy this to .env (already .gitignore'd, never committed) only if you want
# to override a default, e.g. a host port already in use by something else on your machine.

POSTGRES_USER=unihub
POSTGRES_PASSWORD=unihub_dev_only
POSTGRES_DB=unihub
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBITMQ_USER=unihub
RABBITMQ_PASSWORD=unihub_dev_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692

# Required to run the Backend API itself (`./gradlew bootRun`; not used by docker-compose.yml): where the application
# finds the Postgres Master and the RabbitMQ broker. The application has no default for any of these (they are
# environment-only, never set in application.yml), and RabbitMQ's own default user is guest, not the compose user.
# The values below match docker-compose.yml's dev-only defaults: if you change POSTGRES_* / RABBITMQ_* above,
# change these to match. A deployed environment gets them from a Kubernetes Secret.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/unihub
SPRING_DATASOURCE_USERNAME=unihub
SPRING_DATASOURCE_PASSWORD=unihub_dev_only
SPRING_RABBITMQ_HOST=127.0.0.1
SPRING_RABBITMQ_USERNAME=unihub
SPRING_RABBITMQ_PASSWORD=unihub_dev_only

# Observability stack (docker-compose.yml, Phase 6): host ports only. Grafana has no password in the
# repository (anonymous Viewer on 127.0.0.1, see the compose header), so there is no variable for one.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318

# Required to run the Backend API itself (`./gradlew bootRun`; not used by docker-compose.yml): the HMAC
# secret that verifies auth JWTs, at least 32 bytes. Generate one locally, e.g. `openssl rand -base64 48`.
# Never commit a real value — production gets it from a Kubernetes Secret (auth-and-identity.md §3).
UNIHUB_SECURITY_JWT_SECRET=

# Required: Redis backs the seat lock, the scheduled-job lock and the workshop catalog cache (Phase 3
# checklist D21). Without an address the Backend API does not start; an address that is set but unreachable
# starts it and registrations are refused with 503. Local docker-compose Redis has no password. Production
# gets both values from a Kubernetes Secret.
UNIHUB_REDIS_ADDRESS=redis://127.0.0.1:6379
UNIHUB_REDIS_PASSWORD=

# Required: the SMTP server of the EMAIL channel (notification.md §2, Phase 4 checklist D36). Without a host the
# Backend API does not start; a host that is set but unreachable starts it and emails are retried. Locally,
# docker-compose's Mailpit catches everything on port 1025 (web UI on http://127.0.0.1:8025). Username and
# password are runtime secrets: leave them empty for Mailpit, and in a deployed environment they come from a
# Kubernetes Secret, never from a committed file.
UNIHUB_NOTIFICATION_SMTP_HOST=127.0.0.1
UNIHUB_NOTIFICATION_SMTP_PORT=1025
UNIHUB_NOTIFICATION_SMTP_USERNAME=
UNIHUB_NOTIFICATION_SMTP_PASSWORD=

# Required: the private key the QR e-ticket is signed with (checkin.md §4, Phase 5 checklist D49), a private EC
# P-256 JWK as one line of JSON. Without a valid key the Backend API does not start. For local runs make one with
# `scripts/generate-ticket-key.sh --write` (it writes this variable into .env, which is git-ignored, and refuses
# to replace an existing key: replacing it kills every ticket issued with the old one). docker-compose does not
# use it and `./gradlew bootRun` does not read .env: load it with `set -a; . ./.env; set +a`. Never commit a real
# value and never reuse a development key where real tickets are issued: production gets it from a Kubernetes
# Secret (deployment-and-cicd.md §2).
UNIHUB_TICKET_SIGNING_KEY=

# Brochure storage (Phase 5 checklist Q1/D45, workshop.md §4): the S3 client of the brochure flow. Nothing here is
# required to start the Backend API (an unreachable bucket is the case this flow must survive). Locally,
# docker-compose's MinIO answers on http://127.0.0.1:9000 with the dev-only credentials below; a deployed
# environment leaves the endpoint blank (real AWS S3, default endpoint resolution) and gets the credentials from
# a Kubernetes Secret (or an instance role), never from a committed file. CREATE_BUCKET makes the bucket
# `unihub-brochures` if it is missing and sets the anonymous read policy of `covers/*` (Phase 8, D121): local runs
# only, never a deployed environment.
#
# PUBLIC_ENDPOINT (Phase 8, D120) is where a BROWSER reaches the bucket: the origin of the Web, because the Organizer's
# upload and the cover images go through the same origin (Vite's proxy in development, the Istio gateway in the cluster;
# apps/web/vite-plugins/storage-proxy.ts, k8s/base/gateway.yaml). A presigned URL is signed for that host and path, so
# it must be this address. Blank means the same as ENDPOINT, which is right only where the browser sees the bucket at
# the same address (tests, or a bucket on the open Internet). With `npm run dev` use http://localhost:5173.
UNIHUB_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
UNIHUB_OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:5173
UNIHUB_OBJECT_STORAGE_ACCESS_KEY=unihub
UNIHUB_OBJECT_STORAGE_SECRET_KEY=unihub_dev_only
UNIHUB_OBJECT_STORAGE_CREATE_BUCKET=true

# AI Summarization Service (workshop.md §9, D60). No provider is chosen: Phase 5 runs against a stub only, so
# leave the base URL blank and no summary is ever generated (the consumer's message ends in the parking lot).
# When a provider is attached, its URL goes here and its API key in UNIHUB_AI_SUMMARIZATION_API_KEY, a run-time
# secret like every other credential.
UNIHUB_AI_SUMMARIZATION_BASE_URL=
UNIHUB_AI_SUMMARIZATION_API_KEY=

# Dev only (profile `dev`, e.g. SPRING_PROFILES_ACTIVE=dev): password shared by the seeded Student accounts
# student1..3@dev.unihub.local (user.md §10). Unset, nothing is seeded — there is no default password. Never
# set in a deployed environment; the seeder does not exist outside the `dev` profile.
UNIHUB_DEV_SEED_STUDENT_PASSWORD=
# The same for the staff accounts (user.md §10): one password per role, each seeded only when its variable is set —
# organizer1@dev.unihub.local (Organizer), admin1@dev.unihub.local (Admin), staff1@dev.unihub.local (Check-in Staff).
UNIHUB_DEV_SEED_ORGANIZER_PASSWORD=
UNIHUB_DEV_SEED_ADMIN_PASSWORD=
UNIHUB_DEV_SEED_CHECKIN_STAFF_PASSWORD=

# Actuator (observability.md §5, Phase 6 D64): the management port the backend listens on, 8081 unless set. It
# serves health and prometheus only, without a token, and must never be routed from outside. Prometheus in
# docker-compose scrapes host.docker.internal:8081 (observability/prometheus/prometheus.compose.yml): if you
# change the port, change that file too. 8081 is also Expo's default Metro port, so set another one here when
# you run `expo start` on its default.
MANAGEMENT_SERVER_PORT=8081

# Optional: where the backend sends traces (OTLP over HTTP). Unset (the default) means nothing is exported and no
# exporter is created. With docker-compose's Tempo: http://localhost:4318/v1/traces. Traces are sampled at 10%
# (management.tracing.sampling.probability); the trace ID, which is the correlation ID, exists either way.
# Left commented out on purpose: `set -a; . ./.env` exports a blank line as an empty value, which is not the same as unset.
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
