<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot's default logging. Audit no longer has a route of its own: RabbitAuditTrail publishes to the
  broker from a bounded executor (backend-coding-standards.md §12, Phase 6 checklist D68) and every lost entry
  is counted in unihub_audit_publish_failures_total, which replaces the Phase 2 "unihub.audit" logger and its
  non-blocking AsyncAppender.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>
</configuration>
