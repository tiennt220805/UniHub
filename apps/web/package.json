{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../../packages/api-contract/openapi.yaml -o src/shared/api/schema.gen.ts",
    "predev": "npm run api:types",
    "dev": "vite",
    "prebuild": "npm run api:types",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "oxlint && eslint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "jsdom": "29.1.1",
    "msw": "3.0.2",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.0",
    "vitest": "5.0.2"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
