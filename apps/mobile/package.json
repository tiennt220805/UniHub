    "eslint-plugin-boundaries": "7.2.0",
    "jest": "29.7.0",
    "jest-expo": "58.0.11",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.86.0",
    "prettier": "3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
