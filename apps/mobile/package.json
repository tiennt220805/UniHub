    "drizzle-orm": "0.45.4",
    "expo": "58.0.14",
    "expo-camera": "58.0.10",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.23",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
