# Copy to .env (git-ignored) — only values safe to ship in the app bundle belong here: anything with the
# EXPO_PUBLIC_ prefix is readable by whoever has the app.
#
# Where the Backend API is. A phone cannot reach `localhost` on your computer: use the computer's address
# on the same Wi-Fi (System Settings → Wi-Fi → Details), and allow port 8080 through the firewall.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080
