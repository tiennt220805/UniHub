# Exact versions only (docs/guidelines/mobile-coding-standards.md rule 10).
save-exact=true
# Expo SDK packages declare optional peers (react-dom, react-native-web, @expo/dom-webview, ...) that a
# native-only app does not install, and npm without this flag resolves the tree differently from the way Expo
# documents (babel-preset-expo is then missing). Every version is still pinned exactly.
legacy-peer-deps=true
